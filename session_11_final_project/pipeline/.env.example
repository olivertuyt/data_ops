PLATFORM_DB_USER=platform_admin
PLATFORM_DB_PASSWORD=<set-local-secret>
AIRFLOW_DB_NAME=airflow
POLARIS_DB_NAME=polaris
AIRFLOW_ADMIN_PASSWORD=<set-local-secret>
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__PARALLELISM=2
AIRFLOW__CORE__MAX_ACTIVE_TASKS_PER_DAG=2
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://platform_admin:<secret>@platform-db:5432/airflow
AIRFLOW_CONN_TRINO_SHOPVN=trino://airflow@trino:8080/shopvn/gold
MINIO_ROOT_USER=<set-local-user>
MINIO_ROOT_PASSWORD=<set-local-secret>
MINIO_BUCKET=shopvn-lakehouse
MINIO_ENDPOINT=http://minio:9000
ICEBERG_WAREHOUSE=shopvn_catalog
POLARIS_REALM=SHOPVN
POLARIS_CLIENT_ID=root
POLARIS_CLIENT_SECRET=<set-local-secret>
QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://platform-db:5432/polaris
QUARKUS_DATASOURCE_USERNAME=platform_admin
QUARKUS_DATASOURCE_PASSWORD=<set-local-secret>
POLARIS_PERSISTENCE_TYPE=relational-jdbc
SHOPVN_DB_HOST=postgres
SHOPVN_DB_PORT=5432
SHOPVN_DB_NAME=shopvn
SHOPVN_DB_USER=<source-readonly-user>
SHOPVN_DB_PASSWORD=<source-readonly-password>
LOGISTICS_API_URL=http://api:8000
LOGISTICS_API_KEY=<source-api-key>
SFTP_HOST=sftp
SFTP_PORT=22
SFTP_USER=<source-readonly-user>
SFTP_PASSWORD=<source-readonly-password>