# Copy to .env, replace every placeholder, and never commit it.
PLATFORM_DB_USER=platform_admin
PLATFORM_DB_PASSWORD=<set-local-secret>
AIRFLOW_ADMIN_PASSWORD=<set-local-secret>
POLARIS_REALM=SHOPVN
POLARIS_CLIENT_ID=root
POLARIS_CLIENT_SECRET=<set-local-secret>
POLARIS_CATALOG_URI=http://polaris:8181/api/catalog
ICEBERG_WAREHOUSE=shopvn_catalog
MINIO_ROOT_USER=<set-local-user>
MINIO_ROOT_PASSWORD=<set-local-secret>
MINIO_BUCKET=shopvn-lakehouse
SHOPVN_DB_HOST=postgres
SHOPVN_DB_PORT=5432
SHOPVN_DB_NAME=shopvn
SHOPVN_DB_USER=shopvn_reader
SHOPVN_DB_PASSWORD=<set-source-password>
LOGISTICS_API_URL=http://api:8000
LOGISTICS_API_KEY=<set-source-api-key>
SFTP_HOST=sftp
SFTP_PORT=22
SFTP_USER=marketplace_reader
SFTP_PASSWORD=<set-source-password>
PII_HASH_SALT=<set-stable-random-salt>
SHOPVN_ALERT_EMAIL=
SPARK_MASTER=local[2]
SPARK_SHUFFLE_PARTITIONS=4
