# Copy to .env, replace every placeholder, and never commit the resulting file.
# Runtime identity and contract versions
SHOPVN_CODE_VERSION=local-dev
SHOPVN_CONFIG_VERSION=1
SHOPVN_SCHEMA_VERSION=1
PIPELINE_GO_LIVE_DATE=2026-06-01
SHOPVN_TIMEZONE=Asia/Ho_Chi_Minh

# Source network created by ../docker-compose.yml
SHOPVN_SOURCE_NETWORK=session_11_final_project_shopvn-net

# PostgreSQL source (read-only account)
SHOPVN_DB_HOST=postgres
SHOPVN_DB_PORT=5432
SHOPVN_DB_NAME=shopvn
SHOPVN_DB_USER=<set-source-readonly-user>
SHOPVN_DB_PASSWORD=<set-source-readonly-password>

# Logistics API
LOGISTICS_API_URL=http://api:8000
LOGISTICS_API_KEY=<set-source-api-key>
LOGISTICS_API_CONNECT_TIMEOUT_SECONDS=5
LOGISTICS_API_READ_TIMEOUT_SECONDS=35
LOGISTICS_API_REQUESTS_PER_MINUTE=95

# Marketplace SFTP
SFTP_HOST=sftp
SFTP_PORT=22
SFTP_USER=<set-source-readonly-user>
SFTP_PASSWORD=<set-source-readonly-password>
SFTP_REMOTE_BASE_DIR=/marketplace/incoming
SFTP_PARTNERS=lazada,shopee,tiktok

# Platform metadata database
PLATFORM_DB_USER=platform_admin
PLATFORM_DB_PASSWORD=<set-platform-db-secret>
AIRFLOW_DB_NAME=airflow
POLARIS_DB_NAME=polaris

# Iceberg / Polaris / MinIO
POLARIS_REALM=SHOPVN
POLARIS_CLIENT_ID=root
POLARIS_CLIENT_SECRET=<set-polaris-secret>
POLARIS_CATALOG_URI=http://polaris:8181/api/catalog
POLARIS_OAUTH_URI=http://polaris:8181/api/catalog/v1/oauth/tokens
POLARIS_MANAGEMENT_URI=http://polaris:8181/api/management/v1
ICEBERG_WAREHOUSE=shopvn_catalog
MINIO_ROOT_USER=<set-minio-user>
MINIO_ROOT_PASSWORD=<set-minio-secret>
MINIO_BUCKET=shopvn-lakehouse
MINIO_ENDPOINT=http://minio:9000

# Spark runtime
SPARK_MASTER=local[2]
SPARK_DRIVER_MEMORY=768m
SPARK_SHUFFLE_PARTITIONS=4

# PII hashing: stable across runs; rotate only through a documented migration.
PII_HASH_SALT=<set-stable-random-salt>

# Airflow and alerting
AIRFLOW_ADMIN_PASSWORD=<set-airflow-admin-secret>
AIRFLOW_FERNET_KEY=<set-airflow-fernet-key>
AIRFLOW_SECRET_KEY=<set-airflow-web-secret>
SHOPVN_ALERT_EMAIL=

# Read-only serving and dashboards
TRINO_HOST=trino
TRINO_PORT=8080
TRINO_USER=dashboard
TRINO_DISCOVERY_URI=http://trino:8080
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<set-grafana-admin-secret>
