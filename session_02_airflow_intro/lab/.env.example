# Docker image
AIRFLOW_IMAGE_NAME=apache/airflow:2.9.3

# User ID inside Airflow containers
# Linux: run `id -u` to get your UID
# macOS/Windows: leave as default 50000
AIRFLOW_UID=50000

# Base path mounted into containers (default: current directory)
AIRFLOW_PROJ_DIR=.

# Admin credentials for Airflow UI (first login)
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Extra Python packages to install at container startup (leave empty if not needed)
# Note: for production, build a custom image instead
_PIP_ADDITIONAL_REQUIREMENTS=
